# Base URL of the SmartCarCompare backend API (no trailing slash).
# The app calls POST {NEXT_PUBLIC_API_URL}/api/estimate
# This is a NEXT_PUBLIC_ variable, so it is bundled into client-side JS and
# visible in the browser by design — do not put secrets here.
#
# Local development: copy this file to .env and fill in a real value.
# Production (Vercel): set NEXT_PUBLIC_API_URL in Project Settings -> Environment Variables
# instead of committing a .env file.
NEXT_PUBLIC_API_URL=https://your-backend-url.example.com

# Base URL of the standalone auth-service (no trailing slash). The app calls
# POST {NEXT_PUBLIC_AUTH_API_URL}/signup, /login, /logout, /refresh, and
# GET .../me directly from the browser. Also NEXT_PUBLIC_, same rule as
# above: public URL only, never a secret.
NEXT_PUBLIC_AUTH_API_URL=https://your-auth-service-url.example.com

# Public base URL of the site itself (no trailing slash), used for canonical
# links, sitemap.xml, robots.txt and structured data, e.g.
# https://www.your-domain.ro. On Vercel it falls back to the project's
# production domain if unset.
NEXT_PUBLIC_SITE_URL=https://your-site-url.example.com
